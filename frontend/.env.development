# Non-secret local development API target. Vite loads this automatically for
# `npm run dev`; production builds continue to use the container-safe fallback.
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Optional development-only identity for the server-authorized HITL actions.
# Leave unset for the default USER identity. For the safe admin demo, put this
# in an ignored frontend/.env.development.local file instead:
# VITE_AGENTSHIELD_DEV_AUTH_TOKEN=dev-admin-token
# VITE_AGENTSHIELD_DEV_SUBJECT_ID=admin_demo
