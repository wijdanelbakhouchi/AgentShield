# AgentShield environment template
# Provider Selection: auto | gemini | groq | ollama | openai
LLM_PROVIDER=auto
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_FALLBACK_ENABLED=true

# Persistence (SQLite default)
DATABASE_URL=sqlite:///./agent_shield.db
AGENTSHIELD_ENV=development
# Research/demo-only server-owned subject/token fixtures. Production rejects
# these identities regardless of this value.
AGENTSHIELD_DEV_AUTH_ENABLED=true
# Local-only lowest-privilege chat demo. Set false to require a bearer token
# in development. Production always rejects this mode and development tokens.
AGENTSHIELD_DEV_ANONYMOUS_DEMO=true
AGENTSHIELD_API_AUTH_REQUIRED=false
AGENTSHIELD_HTTPS_DEPLOYMENT=false
# Production only: JSON token mapping held in a secret manager, never committed.
# AGENTSHIELD_API_TOKENS={"replace-with-opaque-token":{"subject_id":"user-1","role":"USER"}}
AGENTSHIELD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
AGENTSHIELD_DEV_HOST=127.0.0.1
AGENTSHIELD_DEV_PORT=8001
APPROVAL_TTL_SECONDS=600
AGENTSHIELD_TOOL_SANDBOX=

# Local Docker dashboard telemetry. Use only the development fixture token;
# never place a production credential in frontend build arguments.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AGENTSHIELD_DEV_AUTH_TOKEN=dev-analyst-token

# Option 1: Google Gemini (FREE API key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Option 2: Groq (configure an active model at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.6-27b

# Option 3: Ollama (100% FREE & LOCAL - Install Ollama and run: ollama pull llama3.2)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Option 4: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

LLM_TEMPERATURE=0.7

# Canonical security semantics (Phase 6.5 post-hardening calibration)
RISK_LOW_MAX=0.07
RISK_MEDIUM_MAX=0.13
RISK_HIGH_MAX=0.16
POLICY_BLOCK_THRESHOLD=0.17
RULE_WEIGHT=0.40
SIMILARITY_WEIGHT=0.30
CLASSIFIER_WEIGHT=0.00
CONTEXT_WEIGHT=0.30
POLICY_FLAG_OVERRIDE=false
POLICY_MODE=banded
POLICY_MEDIUM_ACTION=SANITIZE
POLICY_HIGH_ACTION=REVIEW
POLICY_CRITICAL_ACTION=BLOCK
THREAT_VECTOR_THRESHOLD=0.40
EMBEDDING_MATCH_THRESHOLD=0.35
THREAT_MEDIUM_THRESHOLD=0.30
THREAT_HIGH_THRESHOLD=0.60
THREAT_CRITICAL_THRESHOLD=0.85
INTER_AGENT_ALLOW_THRESHOLD=0.35

# Phase 5 detector hardening safeguards (internal representation processing)
MAX_INPUT_LENGTH=100000
MAX_DECODED_LENGTH=32000
MAX_DECODE_DEPTH=3
MAX_REPRESENTATIONS=24
MAX_CANDIDATES_PER_REPRESENTATION=32
AGENTSHIELD_MAX_REQUEST_BODY_BYTES=262144
AGENTSHIELD_MAX_PROMPT_LENGTH=32000
AGENTSHIELD_MAX_CONTEXT_LENGTH=96000
AGENTSHIELD_RATE_LIMIT_CHAT_PER_MINUTE=30
AGENTSHIELD_RATE_LIMIT_ANALYZE_PER_MINUTE=60
AGENTSHIELD_RATE_LIMIT_ADMIN_PER_MINUTE=20
AGENTSHIELD_TOOL_MAX_CALLS_PER_REQUEST=8
AGENTSHIELD_TOOL_MAX_CALLS_PER_AGENT=4
AGENTSHIELD_TOOL_MAX_IDENTICAL_CALLS=2
# Opt in only after reviewing third-party search-provider data handling.
AGENTSHIELD_LIVE_WEB_SEARCH_ENABLED=false
AGENTSHIELD_WEB_SEARCH_TIMEOUT_SECONDS=4
AGENTSHIELD_SECURITY_DEGRADED_MODE=restrict_sensitive_tools
AGENTSHIELD_OPERATIONAL_LOG_PROMPTS=false
AGENTSHIELD_OPERATIONAL_LOG_MAX_CHARS=512

# Phase 6 real local semantic similarity (active in the calibrated scorer)
SEMANTIC_SIMILARITY_ENABLED=true
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
SEMANTIC_SIMILARITY_THRESHOLD=0.51
SEMANTIC_TOP_K=3
SEMANTIC_BATCH_SIZE=16
SEMANTIC_MAX_REPRESENTATIONS=8
SEMANTIC_CORPUS_PATH=experiments/semantic_similarity/attack_corpus.json
